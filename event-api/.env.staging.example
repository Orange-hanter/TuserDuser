# Example Staging Environment Variables
# Copy this file to .env.staging and fill in the values

# Server Configuration
PORT=8080
HOST=0.0.0.0
ENV=staging

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=staging_password_change_me
DB_NAME=event_api_staging
DB_SSLMODE=disable

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=staging_redis_password
REDIS_DB=0

# JWT Configuration
JWT_SECRET=staging_jwt_secret_key_change_me_32_chars_minimum
JWT_EXPIRATION=24h

# Email Configuration (SMTP)
# For staging you can use Mailtrap or similar testing service
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=your_mailtrap_username
SMTP_PASSWORD=your_mailtrap_password
SMTP_FROM=staging@yourdomain.com

# SMS Configuration
# Use mock provider for staging
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_API_TOKEN=
SMS_FROM=StagingApp

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://staging.yourdomain.com,http://localhost:3000,http://localhost:8080
