{
  "dashboard": {
    "id": null,
    "uid": "event-api-traces",
    "title": "Event API - Traces",
    "description": "Distributed tracing dashboard for Event API using Tempo",
    "tags": ["event-api", "traces", "tempo"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "templating": {
      "list": [
        {
          "name": "tempo_datasource",
          "type": "datasource",
          "query": "tempo",
          "current": {
            "selected": true,
            "text": "Tempo",
            "value": "Tempo"
          }
        },
        {
          "name": "prometheus_datasource",
          "type": "datasource",
          "query": "prometheus",
          "current": {
            "selected": true,
            "text": "Prometheus",
            "value": "Prometheus"
          }
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "Trace Search",
        "type": "traces",
        "gridPos": { "h": 12, "w": 24, "x": 0, "y": 0 },
        "datasource": { "type": "tempo", "uid": "tempo" },
        "targets": [
          {
            "queryType": "traceqlSearch",
            "limit": 20,
            "filters": [
              {
                "id": "service-name",
                "operator": "=",
                "scope": "resource",
                "tag": "service.name",
                "value": ["event-api"],
                "valueType": "string"
              }
            ]
          }
        ]
      },
      {
        "id": 2,
        "title": "Trace Duration Distribution",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"event-api\"}[5m])))",
            "legendFormat": "p50"
          },
          {
            "expr": "histogram_quantile(0.90, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"event-api\"}[5m])))",
            "legendFormat": "p90"
          },
          {
            "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"event-api\"}[5m])))",
            "legendFormat": "p99"
          }
        ],
        "options": {
          "legend": { "displayMode": "list", "placement": "bottom" }
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10
            },
            "unit": "s"
          }
        }
      },
      {
        "id": 3,
        "title": "Slow Traces (>500ms)",
        "type": "traces",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
        "datasource": { "type": "tempo", "uid": "tempo" },
        "targets": [
          {
            "queryType": "traceql",
            "query": "{ resource.service.name = \"event-api\" } | duration > 500ms",
            "limit": 10
          }
        ]
      },
      {
        "id": 4,
        "title": "Error Traces",
        "type": "traces",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
        "datasource": { "type": "tempo", "uid": "tempo" },
        "targets": [
          {
            "queryType": "traceql",
            "query": "{ resource.service.name = \"event-api\" && status = error }",
            "limit": 10
          }
        ]
      },
      {
        "id": 5,
        "title": "Spans by Operation",
        "type": "barchart",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "sum by (http_route) (increase(http_server_request_duration_seconds_count{job=\"event-api\"}[1h]))",
            "legendFormat": "{{http_route}}"
          }
        ],
        "options": {
          "orientation": "horizontal",
          "xTickLabelRotation": 0,
          "stacking": "none"
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "fillOpacity": 80
            }
          }
        }
      }
    ]
  },
  "overwrite": true
}
