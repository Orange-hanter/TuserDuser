# Example Production Environment Variables
# Copy this file to .env.production and fill in the values

# Server Configuration
PORT=8080
HOST=0.0.0.0
ENV=production

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=event_api
DB_SSLMODE=require

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0

# JWT Configuration
JWT_SECRET=CHANGE_ME_VERY_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARACTERS
JWT_EXPIRATION=24h

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM=noreply@yourdomain.com

# SMS Configuration
# Options: mock, smsru, smsc, twilio
SMS_PROVIDER=smsru
SMS_API_KEY=your_sms_api_key
SMS_API_TOKEN=your_sms_api_token
SMS_FROM=YourAppName

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://app.yourdomain.com

# OpenTelemetry Configuration
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
OTEL_SERVICE_NAME=event-api
