# Environment
ENV=development

# Server ports
GRPC_PORT=50051
HTTP_PORT=8081

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5433/telegram_service?sslmode=disable

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_API_BASE_URL=https://api.telegram.org

# Update mode: "webhook" or "polling"
# Use "polling" when you don't have a static IP
TELEGRAM_UPDATE_MODE=webhook

# Webhook settings (only for webhook mode)
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret
TELEGRAM_WEBHOOK_ALIAS=default

# Polling settings (only for polling mode)
TELEGRAM_POLLING_TIMEOUT=30
TELEGRAM_POLLING_RETRY_DELAY=3

# Token Configuration
TELEGRAM_BINDING_SECRET=your_binding_secret_min_32_chars
TELEGRAM_BINDING_TTL=3600

# Rate Limiting
TELEGRAM_RATE_LIMIT=30
TELEGRAM_MAX_RETRIES=3
TELEGRAM_RETRY_BASE_SECONDS=5
